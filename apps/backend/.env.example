# Copy to .env.local — never commit real values

# Postgres (Railway provides this automatically in production)
DATABASE_URL=postgres://binchen:your-password@localhost:5432/binchen_dev

# Medusa secrets (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here
COOKIE_SECRET=your-cookie-secret-here

# Stripe (use test keys locally)
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# CORS origins (comma-separated)
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7001,http://localhost:3000

# Sentry (get DSN from https://sentry.io)
SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# Worker mode (leave empty for single-instance dev)
# MEDUSA_WORKER_MODE=worker
