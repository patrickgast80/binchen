# Copy to .env.local — never commit real values

# Postgres (Railway provides this automatically in production)
DATABASE_URL=postgres://binchen:your-password@localhost:5432/binchen_dev

# Medusa secrets (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here
COOKIE_SECRET=your-cookie-secret-here

# PayPal — only payment provider as of 2026-06-13 (board pivot, BIL-124).
# Backend module activates only when CLIENT_ID + CLIENT_SECRET are both set.
# Use sandbox credentials locally; real keys live in Render.
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_MODE=sandbox

# CORS origins (comma-separated)
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7001,http://localhost:3000

# Backend URL (used by admin panel and file module)
MEDUSA_BACKEND_URL=http://localhost:9000

# Sentry (get DSN from https://sentry.io)
SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# First-boot admin user creation (set once on Render/Railway; unset after first boot if desired)
# If MEDUSA_ADMIN_EMAIL + MEDUSA_ADMIN_PASSWORD are both set, the startup CMD creates the
# first admin user on first deploy (idempotent — `medusa user` errors silently on duplicate).
MEDUSA_ADMIN_EMAIL=admin@binchen.de
MEDUSA_ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# Worker mode (leave empty for single-instance dev)
# MEDUSA_WORKER_MODE=worker
