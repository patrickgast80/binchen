{
  "ts-node": {
    "transpileOnly": true
  },
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": ".medusa/server",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@medusajs/framework/utils": [
        "./node_modules/@medusajs/framework/dist/utils/index",
        "../../node_modules/@medusajs/framework/dist/utils/index"
      ],
      "@medusajs/framework/http": [
        "./node_modules/@medusajs/framework/dist/http/index",
        "../../node_modules/@medusajs/framework/dist/http/index"
      ],
      "@medusajs/framework/types": [
        "./node_modules/@medusajs/framework/dist/types/index",
        "../../node_modules/@medusajs/framework/dist/types/index"
      ]
    }
  },
  "include": ["src", "medusa-config.ts"],
  "exclude": ["node_modules", ".medusa"]
}
