# Copy to .env.local — never commit real values

# Medusa backend URL
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa storefront publishable key (get from Medusa admin)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your-key-here

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# On-demand revalidation webhook secret (generate with: openssl rand -base64 32)
REVALIDATION_SECRET=your-revalidation-secret-here

# PayPal Smart Button (BIL-125)
# Sandbox: get from developer.paypal.com → My Apps & Credentials → Sandbox → Client ID
# Production: swap in Vercel env vars (live client id provisioned by board)
# Leave unset to hide the PayPal block entirely (safe for dev without a sandbox account)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
