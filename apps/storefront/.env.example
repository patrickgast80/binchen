# Copy to .env.local — never commit real values.
# For Coolify: set the same vars in the application's Environment settings.
# Vars prefixed NEXT_PUBLIC_* are baked into the client bundle at build time.

# --- Medusa backend ---
# Required. Public URL of the Medusa backend (server- and client-side fetches).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Required. Publishable key from Medusa admin → Settings → API Key Management.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your-key-here

# --- Observability ---
# Optional. Sentry browser DSN.
NEXT_PUBLIC_SENTRY_DSN=

# --- Revalidation ---
# Required for on-demand ISR. Generate with: openssl rand -base64 32
REVALIDATION_SECRET=your-revalidation-secret-here

# --- Payments ---
# Optional. PayPal Smart Button (BIL-125).
# Sandbox: get from developer.paypal.com → My Apps & Credentials → Sandbox → Client ID.
# Production: live client id provisioned by board.
# Leave unset to hide the PayPal block entirely (safe for dev without a sandbox account).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Hosting / domain ---
# Optional. When set to "true", traffic on the legacy binchen.vercel.app host is
# 301-redirected to bilulu.de. Coolify deploy should leave this unset.
BILULU_CANONICAL_REDIRECT=

# --- Coolify / Docker runtime (no need to set in .env.local) ---
# PORT=3000               # Container listens on 3000; map to 80/443 at the proxy.
# HOSTNAME=0.0.0.0        # Bind to all interfaces so Coolify's proxy can reach it.
# NODE_ENV=production     # Set automatically by the runner stage.
