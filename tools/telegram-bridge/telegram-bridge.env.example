# Telegram bridge config (BIL-2481).
# Real file lives at infra/.vault/telegram-bridge.env — NEVER commit it.

# From @BotFather (board action, see BIL-2480)
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to post (board decides).
# A user finds their ID e.g. via @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# Long-lived Paperclip agent API key (board mints it: Agents -> DevOps -> API keys,
# scope task_bridge). Agent JWTs from runs expire after 1h — do not use those.
PAPERCLIP_TOKEN=

# Defaults are correct for this machine; override only if the instance moves.
PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_COMPANY_ID=723a0156-47d4-4ec0-9d21-81a1cebeb182
PAPERCLIP_PROJECT_ID=5e251e01-8c35-4243-9a64-ebccc2ffed74

# Where plain text messages land when no "BIL-1234:" prefix is given.
DEFAULT_ISSUE_KEY=BIL-1
